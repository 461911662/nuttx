#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_BOARD_20260409_BOSS0

config 20260409_BOSS0_GPIO_EXP
    bool "GPIO Expander (XL9555)"
    select I2C
    select IOEXPANDER
    select DEV_GPIO
    select GPIO_LOWER_HALF
    select IOEXPANDER_XL9555_INT
    select IOEXPANDER_INT_ENABLE
    select ESP32S3_I2C0
    select ESP32S3_GPIO_IRQ
    help
        Enable GPIO expander support using XL9555 with interrupt.
        This provides /dev/gpio0 through /dev/gpio15 for the 16
        GPIO pins on the XL9555 IO expander.

if 20260409_BOSS0_GPIO_EXP

config 20260409_BOSS0_GPIO_EXP_IRQ_PIN
    int "GPIO Expander IRQ Pin"
    default 16
    range 0 48
    help
        GPIO pin for XL9555 INT (interrupt output).

config 20260409_BOSS0_GPIO_EXP_ADDR
    hex "GPIO Expander I2C Address"
    default 0x20
    help
        I2C address of XL9555 (0x08-0x77).

config 20260409_BOSS0_GPIO_EXP_FREQ
    int "GPIO Expander I2C Frequency (Hz)"
    default 400000
    help
        I2C bus frequency for XL9555 communication.

endif

endif # ARCH_BOARD_20260409_BOSS0
