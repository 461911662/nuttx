#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_BOARD_ESP32S3_BOSS1_CX

config ESP32S3_BOSS1_CX_GPIO_EXP
    bool "GPIO Expander (XL9555)"
    select I2C
    select IOEXPANDER
    select DEV_GPIO
    select GPIO_LOWER_HALF
    select IOEXPANDER_XL9555_INT
    select IOEXPANDER_INT_ENABLE
    select ESP32S3_I2C0
    select ESP32S3_GPIO_IRQ
    help
        Enable GPIO expander support using XL9555 with interrupt.
        This provides /dev/gpio0 through /dev/gpio15 for the 16
        GPIO pins on the XL9555 IO expander.

if ESP32S3_BOSS1_CX_GPIO_EXP

config ESP32S3_BOSS1_CX_GPIO_EXP_IRQ_PIN
    int "GPIO Expander IRQ Pin"
    default 17
    range 0 48
    help
        GPIO pin for XL9555 INT (interrupt output).

config ESP32S3_BOSS1_CX_GPIO_EXP_ADDR
    hex "GPIO Expander I2C Address"
    default 0x20
    help
        I2C address of XL9555 (0x08-0x77).

config ESP32S3_BOSS1_CX_GPIO_EXP_FREQ
    int "GPIO Expander I2C Frequency (Hz)"
    default 400000
    help
        I2C bus frequency for XL9555 communication.

endif

config ESP32S3_BOSS1_CX_I2S0
    bool "I2S Microphone (LMD4030)"
    default n
    help
        Enable I2S for LMD4030 PDM microphone (master mode)

if ESP32S3_BOSS1_CX_I2S0

config ESP32S3_BOSS1_CX_I2S0_TX
    bool "I2S0 TX (Output)"
    default n

config ESP32S3_BOSS1_CX_I2S0_RX
    bool "I2S0 RX (Input)"
    default y

endif

config ESP32S3_BOSS1_CX_I2S1
    bool "I2S Audio (NS4168)"
    depends on ESP32S3_BOSS1_CX_GPIO_EXP
    default n
    help
        Enable I2S audio support for NS4168 amplifier

if ESP32S3_BOSS1_CX_I2S1

config ESP32S3_BOSS1_CX_I2S1_TX
    bool "I2S0 TX (Output)"
    default y

config ESP32S3_BOSS1_CX_I2S1_RX
    bool "I2S0 RX (Input)"
    default n

endif

endif # ARCH_BOARD_ESP32S3_BOSS1_CX
