CSRCS = esp32s3_boot.c esp32s3_bringup.c

# GPIO expander (XL9555)
ifeq ($(CONFIG_ESP32S3_BOSS1_CX_GPIO_EXP),y)
CSRCS += esp32s3_gpioexp.c
endif

# Speaker driver (NS4168 with power control)
ifeq ($(CONFIG_ESP32S3_BOSS1_CX_SPEAKER),y)
CSRCS += esp32s3_spk.c
endif

# Native ESP32-S3 GPIO
ifeq ($(CONFIG_DEV_GPIO),y)
CSRCS += esp32s3_gpio.c
endif

# Button driver (XL9555)
ifeq ($(CONFIG_ARCH_BUTTONS),y)
CSRCS += esp32s3_buttons.c
endif

# RMT driver (IR TX and WS2812)
ifeq ($(CONFIG_ESP_RMT),y)
CSRCS += esp32s3_rmt.c
endif

# LCD ST7789 driver (8-bit parallel I80)
ifeq ($(CONFIG_ESP32S3_BOSS1_CX_LCD_I80),y)
CSRCS += board_lcd_st7789.c
endif

# FT6336U touchscreen driver
ifeq ($(CONFIG_ESP32S3_BOSS1_CX_TOUCHSCREEN_FT6336U),y)
CSRCS += board_touchscreen_ft6336u.c
endif

ifeq ($(CONFIG_BOARDCTL),y)
CSRCS += esp32s3_appinit.c
ifeq ($(CONFIG_BOARDCTL_RESET),y)
CSRCS += esp32s3_reset.c
endif
endif

ifeq ($(CONFIG_ARCH_LEDS),y)
CSRCS += esp32s3_autoleds.c
endif

ifeq ($(CONFIG_USERLED),y)
CSRCS += esp32s3_userleds.c
endif

DEPPATH += --dep-path board
VPATH += :board
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)arch$(DELIM)$(CONFIG_ARCH)$(DELIM)src$(DELIM)board$(DELIM)board
