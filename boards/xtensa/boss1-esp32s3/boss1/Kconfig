# 	default n
# 	help
# 		If enable, application will startup from special process.

# endif # ESP32S3_BOSS1_V1_0

if ESP32S3_BOSS1_V1_0_0

config BOSS1_ESP32S3_ETC_MTD
	bool "Enable /etc MTD partition on SPI Flash"
	depends on BOSS1_ESP32S3_MTD
	default n
	---help---
		Enable a separate MTD partition for /etc directory.
		This partition will be mounted at /etc and used to store
		password files and other configuration data.

config BOSS1_ESP32S3_ETC_MTD_OFFSET
	hex "ETC MTD base address in SPI Flash"
	default 0x180000 if !BOSS1_ESP32S3_HAVE_OTA_PARTITION
	default 0x250000 if BOSS1_ESP32S3_HAVE_OTA_PARTITION
	depends on BOSS1_ESP32S3_ETC_MTD
	---help---
		MTD base address in SPI Flash for /etc partition.

config BOSS1_ESP32S3_ETC_MTD_SIZE
	hex "ETC MTD size in SPI Flash"
	default 0x40000
	range 0x0 0x80000
	depends on BOSS1_ESP32S3_ETC_MTD
	---help---
		MTD size in SPI Flash for /etc partition.

config BOSS1_ESP32S3_STORAGE_MTD_OFFSET
	hex "Storage MTD base address in SPI Flash"
	default 0x1A0000 if BOSS1_ESP32S3_ETC_MTD && !BOSS1_ESP32S3_HAVE_OTA_PARTITION
	default 0x270000 if BOSS1_ESP32S3_ETC_MTD && BOSS1_ESP32S3_HAVE_OTA_PARTITION
	default 0x180000 if !BOSS1_ESP32S3_ETC_MTD && !BOSS1_ESP32S3_HAVE_OTA_PARTITION
	default 0x250000 if !BOSS1_ESP32S3_ETC_MTD && BOSS1_ESP32S3_HAVE_OTA_PARTITION
	depends on BOSS1_ESP32S3_MTD
	---help---
		MTD base address in SPI Flash.

config BOSS1_ESP32S3_STORAGE_MTD_SIZE
	hex "Storage MTD size in SPI Flash"
	default 0xE0000 if BOSS1_ESP32S3_ETC_MTD
	default 0x100000 if !BOSS1_ESP32S3_ETC_MTD
	range 0x0 0x400000 if BOSS1_ESP32S3_FLASH_4M
	range 0x0 0x800000 if BOSS1_ESP32S3_FLASH_8M
	range 0x0 0x1000000 if BOSS1_ESP32S3_FLASH_16M
	range 0x0 0x2000000 if BOSS1_ESP32S3_FLASH_32M
	depends on BOSS1_ESP32S3_MTD
	---help---
		MTD size in SPI Flash.

choice BOSS1_ESP32S3_SPIFLASH_FS
	prompt "Mount SPI Flash MTD on bring-up"
	default BOSS1_ESP32S3_SPIFLASH_SMARTFS
	depends on BOSS1_ESP32S3_MTD
	optional
	---help---
		Mount the SPI Flash MTD with the selected File System format on board
		bring-up.
		If not selected, the MTD will be registered as a device node on /dev.

config BOSS1_ESP32S3_SPIFLASH_SMARTFS
	bool "SmartFS"
	select FS_SMARTFS
	select MTD_SMART

config BOSS1_ESP32S3_SPIFLASH_NXFFS
	bool "NXFFS"
	select FS_NXFFS

config BOSS1_ESP32S3_SPIFLASH_SPIFFS
	bool "SPIFFS"
	select FS_SPIFFS

config BOSS1_ESP32S3_SPIFLASH_LITTLEFS
	bool "LittleFS"
	select FS_LITTLEFS

endchoice # BOSS1_ESP32S3_SPIFLASH_FS

if PM

config PM_ALARM_SEC
	int "PM_STANDBY delay (seconds)"
	default 15
	---help---
		Number of seconds to wait in PM_STANDBY before going to PM_STANDBY mode.

config PM_ALARM_NSEC
	int "PM_STANDBY delay (nanoseconds)"
	default 0
	---help---
		Number of additional nanoseconds to wait in PM_STANDBY before going to PM_STANDBY mode.

config PM_SLEEP_WAKEUP_SEC
	int "PM_SLEEP delay (seconds)"
	default 20
	---help---
		Number of seconds to wait in PM_SLEEP.

config PM_SLEEP_WAKEUP_NSEC
	int "PM_SLEEP delay (nanoseconds)"
	default 0
	---help---
		Number of additional nanoseconds to wait in PM_SLEEP.

endif # PM

config BOSS1_ESP32S3_XL9555
    bool "XL9555 IO Expander support"
    default n
    depends on BOSS1_ESP32S3_I2C && BOSS1_ESP32S3_GPIO_IRQ
    select IOEXPANDER_XL9555
    ---help---
        Enable XL9555 IO Expander on BOSS1 board.

if BOSS1_ESP32S3_XL9555

choice BOSS1_ESP32S3_XL9555_I2C_PORT
    prompt "I2C port"
    default BOSS1_ESP32S3_XL9555_I2C0

config BOSS1_ESP32S3_XL9555_I2C0
    bool "I2C0"

config BOSS1_ESP32S3_XL9555_I2C1
    bool "I2C1"
endchoice

config BOSS1_ESP32S3_XL9555_IRQ_PIN
    int "Interrupt GPIO pin (-1 to disable)"
    default -1
    range -1 48
    ---help---
        GPIO pin for XL9555 interrupt (-1 to disable interrupt mode).

choice BOSS1_ESP32S3_XL9555_IRQ_TYPE
    prompt "Interrupt trigger type"
    depends on BOSS1_ESP32S3_XL9555_IRQ_PIN >= 0
    default BOSS1_ESP32S3_XL9555_IRQ_FALLING

config BOSS1_ESP32S3_XL9555_IRQ_RISING
    bool "Rising edge"

config BOSS1_ESP32S3_XL9555_IRQ_FALLING
    bool "Falling edge"

config BOSS1_ESP32S3_XL9555_IRQ_CHANGE
    bool "Both edges"

config BOSS1_ESP32S3_XL9555_IRQ_LOW
    bool "Low level"

config BOSS1_ESP32S3_XL9555_IRQ_HIGH
    bool "High level"
endchoice

config BOSS1_ESP32S3_XL9555_ADDRESS
    hex "XL9555 I2C address"
    default 0x20
    range 0x08 0x77
    ---help---
        I2C address of XL9555 (0x08 - 0x77).
        The address is determined by A0, A1, A2 pins.
        Common values: 0x20-0x27 based on pin configuration.

config BOSS1_ESP32S3_XL9555_FREQUENCY
    int "XL9555 I2C frequency (Hz)"
    default 400000
    range 100000 1000000
    ---help---
        I2C bus frequency for XL9555 communication.
        Typical values: 100000 (100kHz) or 400000 (400kHz).

if BOSS1_ESP32S3_XL9555_IRQ_PIN >= 0

config BOSS1_ESP32S3_XL9555_INT_ENABLE
    bool "Enable XL9555 interrupt support"
    default y
    ---help---
        Enable interrupt support for XL9555.

if BOSS1_ESP32S3_XL9555_INT_ENABLE

config BOSS1_ESP32S3_XL9555_INT_NCALLBACKS
    int "Number of interrupt callbacks"
    default 4
    range 1 8
    ---help---
        Maximum number of interrupt callbacks that can be registered.

choice BOSS1_ESP32S3_XL9555_INT_WORK
    prompt "Interrupt work queue"
    default BOSS1_ESP32S3_XL9555_INT_HPWORK

config BOSS1_ESP32S3_XL9555_INT_HPWORK
    bool "High priority work queue"

config BOSS1_ESP32S3_XL9555_INT_LPWORK
    bool "Low priority work queue"

endchoice

endif # BOSS1_ESP32S3_XL9555_INT_ENABLE

endif # BOSS1_ESP32S3_XL9555_IRQ_PIN >= 0

config BOSS1_ESP32S3_XL9555_CHARDEV
    bool "Enable XL9555 character device"
    default n
    ---help---
        Register a character device (/dev/xl95550) for user-space access to XL9555 IO expander.

endif

endif # ESP32S3_BOSS1_V1_0_0
